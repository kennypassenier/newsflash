# newsflash systemd USER unit (K7, AR20). Install:
#   mkdir -p ~/.config/systemd/user
#   cp systemd/newsflash.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now newsflash
# Token comes from latch (M6); the fallback is a plain EnvironmentFile —
# see docs/OPERATIONS_RUNBOOK.md R1.

[Unit]
Description=newsflash — kyu hub messages as desktop toasts
# Start after the session (and its notification service) is up; STOP at
# logout — no session-less courier acking toasts nobody sees (AR20);
# the subscription's TTL cleans the logged-out gap (S4).
After=graphical-session.target
PartOf=graphical-session.target
# A crash loop stops before persistent-toast duplication wallpapers the
# screen (AR6 counter-argument).
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# M6: latch injects KYU_TOKEN; nothing secret in this file or argv.
# latch resolves its project from the working directory (drill-proven
# 2026-08-29), so point it at the linked repo.
# Fallback without latch: replace ExecStart with the plain binary and
# add: EnvironmentFile=%h/.config/newsflash/token.env
WorkingDirectory=%h/Projects/hub-clients
ExecStart=%h/.cargo/bin/latch run -- %h/.cargo/bin/newsflash
Restart=on-failure
RestartSec=5
# Bounded stop: above the worst case of a 30 s poll read + settle (AR19).
TimeoutStopSec=45

[Install]
WantedBy=graphical-session.target
